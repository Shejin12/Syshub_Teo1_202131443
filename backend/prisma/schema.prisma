// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Status {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  projects ProjectTag[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  bio       String?
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  statusId  Int
  status    Status   @relation(fields: [statusId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  projects            Project[]      @relation("AuthorProjects")
  highlightedProjects Project[]      @relation("HighlightedProjects")
  threads             Thread[]
  comments            Comment[]
  votes               Vote[]
  recoveryCodes       RecoveryCode[]
  blogs               Blog[]
  reports             Report[]
}

model RecoveryCode {
  id        Int      @id @default(autoincrement())
  code      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("codigos_recuperacion")
}

model Project {
  id              Int          @id @default(autoincrement())
  title           String
  description     String
  techStack       String
  fileUrl         String?
  attachments     String?
  category        String?
  author          User         @relation("AuthorProjects", fields: [authorId], references: [id], onDelete: Cascade)
  authorId        Int
  highlightedBy   User?        @relation("HighlightedProjects", fields: [highlightedById], references: [id])
  highlightedById Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tags            ProjectTag[]
  comments        Comment[]
}

model ProjectTag {
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     Int

  @@id([projectId, tagId])
}

model Thread {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  category    String?
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  comments    Comment[]
  votes       Vote[]
}

model Comment {
  id          Int       @id @default(autoincrement())
  content     String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int
  
  thread      Thread?   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId    Int?
  
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int?
  
  blog        Blog?     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogId      Int?

  parentId    Int?
  parent      Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentToComment")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  votes       Vote[]
}

model Blog {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]
}

model Vote {
  id          Int      @id @default(autoincrement())
  value       Int      // 1 for upvote, -1 for downvote
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  thread      Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId    Int?

  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId   Int?

  @@unique([userId, threadId])
  @@unique([userId, commentId])
}

model Report {
  id          Int      @id @default(autoincrement())
  reason      String
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId  Int

  targetType  String   // "PROJECT", "THREAD", "COMMENT", "BLOG"
  targetId    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
